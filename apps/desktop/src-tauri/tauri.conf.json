{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATK HUB",
  "version": "1.0.0",
  "identifier": "com.atk.hub.reconstruction",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ATK HUB",
        "width": 1200,
        "height": 760,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../apps/lua-worker/target/release/lua-worker.exe": "lua-worker.exe"
    },
    "targets": ["nsis"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "allowDowngrades": false,
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGM0IyNDA0MTYxMzhCOEEKUldTS2l4TVdCQ1E3TDdqZks3bnlkVmRsUGRRWm9JcXZBTEZQYnNwK3BvWGRlVjF5ZWNhTDBYcDEK",
      "endpoints": [
        "https://github.com/nora77zz/VXE-R1-SE-PLUS-NORA/releases/latest/download/latest.json"
      ]
    }
  }
}
